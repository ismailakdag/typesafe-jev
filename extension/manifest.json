{
  "manifest_version": 3,
  "name": "Ilan Yakala",
  "version": "0.1.0",
  "description": "Gezdigin ilan sayfasini tek tikla yapilandirilmis veri olarak yerel arsivine kaydeder.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Bu sayfayi yakala (genel mod)" },
  "content_scripts": [
    {
      "matches": ["https://www.sahibinden.com/*"],
      "js": ["extract.js", "content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ]
}
